###############################################################################
# Wyze RTSP Bridge — Environment Configuration
#
# Copy this file to ".env" and fill in your values.
# The .env file is gitignored — NEVER commit real credentials.
#
# All secrets live only in this file and in container memory.
# Nothing is written to disk inside the container.
###############################################################################

# ── Wyze Account Credentials ─────────────────────────────────────────────────
#
# Option A: Email / password (most common)
WYZE_EMAIL=your@email.com
WYZE_PASSWORD=your_wyze_password

# If your account has 2-Factor Authentication enabled, provide the base32
# TOTP secret from your authenticator app setup screen (NOT the 6-digit code).
# Example: WYZE_TOTP_KEY=JBSWY3DPEHPK3PXP
WYZE_TOTP_KEY=

# Option B: Wyze API Key (newer method — doesn't support streaming yet,
# but included for future compatibility).  Leave blank when using email/password.
WYZE_API_KEY=
WYZE_KEY_ID=

# ── Camera Filter (optional) ──────────────────────────────────────────────────
#
# Comma-separated list of camera friendly names or MAC addresses to bridge.
# Leave empty to bridge ALL cameras on the account.
#
# Examples:
#   CAMERAS=Front Door,Backyard,Garage
#   CAMERAS=DC:A6:32:XX:XX:XX,DC:A6:32:YY:YY:YY
CAMERAS=

# ── RTSP Server ───────────────────────────────────────────────────────────────

# Port for RTSP connections (default: 8554)
RTSP_PORT=8554

# Port for HLS (HTTP Live Streaming) — browser access (default: 8888)
HLS_PORT=8888

# RTSP read credentials for clients (Home Assistant, VLC, etc.)
# STRONGLY RECOMMENDED even on a local network.
# Leave both empty to allow unauthenticated reads (not recommended).
RTSP_USER=viewer
RTSP_PASSWORD=change_me_please

# ── Video Quality & Network Throughput ───────────────────────────────────────
#
# QUALITY presets:  HD (1080p) | 720p | 480p | SD (640x480) | 360p
#                   or a custom WxH value, e.g.: 1280x720
QUALITY=HD

# Target video bitrate.  Higher = better quality, more bandwidth.
#   Examples: 500k (low bandwidth), 2000k (default), 4M (high quality)
BITRATE=2000k

# Maximum bitrate cap.  Defaults to 1.5× BITRATE if not set.
MAX_BITRATE=

# Output frames per second.  Reducing FPS cuts bandwidth significantly.
#   Wyze cameras natively output 15–20 fps.
FPS=20

# FFmpeg encoder preset:
#   ultrafast (default, lowest CPU) → superfast → veryfast → faster → fast → medium
#   Lower CPU usage = more bandwidth; higher CPU usage = smaller stream size.
ENCODER_PRESET=ultrafast

# FFmpeg output buffer size.  Larger buffers smooth out bitrate spikes
# at the cost of slightly more latency.
BUFFER_SIZE=4M

# Include audio in the RTSP stream (true/false)
AUDIO=true

# ── Advanced ──────────────────────────────────────────────────────────────────

# Seconds to wait before reconnecting after a stream failure (default: 5)
RECONNECT_DELAY=5

# Enable debug logging (true/false).  WARNING: may expose metadata in logs.
# Never enables credential logging.
DEBUG=false
